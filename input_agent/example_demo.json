{
  "metadata": {
    "modelId": "demo-ecommerce-001",
    "version": "1.0",
    "createdAt": "2025-12-17T10:00:00Z",
    "createdBy": "agent-1-interviewer",
    "projectName": "E-Commerce Platform",
    "description": "Modello di esempio con 3 problemi intenzionali per demo"
  },
  "domainMap": {
    "coreDomains": [
      {
        "name": "Order Management",
        "classification": "CORE",
        "valueProposition": "Gestione completa del ciclo vita degli ordini clienti",
        "boundedContexts": [
          {
            "name": "OrderContext",
            "description": "Contesto per gestione ordini",
            "ubiquitousLanguage": {
              "Order": "Richiesta di acquisto da parte del cliente",
              "OrderItem": "Singolo articolo nell'ordine",
              "Product": "Prodotto ordinato dal cliente"
            },
            "entities": [
              {
                "name": "Order",
                "type": "ENTITY",
                "description": "Ordine del cliente",
                "attributes": ["orderId", "customerId", "orderDate", "status", "totalAmount"],
                "invariants": ["Total must be positive", "Must have at least one item"]
              },
              {
                "name": "Product",
                "type": "ENTITY",
                "description": "Prodotto ordinato",
                "attributes": ["productId", "name", "price", "quantity"]
              }
            ],
            "valueObjects": [
              {
                "name": "Address",
                "type": "VALUE_OBJECT",
                "description": "Indirizzo di spedizione",
                "attributes": ["street", "city", "postalCode", "country"]
              }
            ],
            "aggregates": [
              {
                "name": "OrderAggregate",
                "root": "Order",
                "entities": ["Order", "Product"],
                "valueObjects": ["Address"]
              }
            ]
          }
        ],
        "functionalRequirements": [
          {
            "id": "FR-ORD-001",
            "description": "Gli ordini devono essere immutabili dopo la conferma",
            "priority": "HIGH",
            "rationale": "Garantire integrità dati per fatturazione e spedizione"
          },
          {
            "id": "FR-ORD-002",
            "description": "Gli utenti possono modificare gli ordini entro 24 ore dalla creazione",
            "priority": "HIGH",
            "rationale": "Permettere correzioni errori da parte del cliente"
          }
        ],
        "nonFunctionalRequirements": [
          {
            "id": "NFR-ORD-001",
            "category": "PERFORMANCE",
            "description": "Creazione ordine deve completarsi in meno di 2 secondi"
          }
        ]
      },
      {
        "name": "Product Catalog",
        "classification": "CORE",
        "valueProposition": "Catalogo prodotti completo e sempre aggiornato",
        "boundedContexts": [
          {
            "name": "CatalogContext",
            "description": "Contesto per gestione catalogo prodotti",
            "ubiquitousLanguage": {
              "Product": "Articolo disponibile nel catalogo",
              "Category": "Categoria merceologica del prodotto",
              "Inventory": "Disponibilità in magazzino"
            },
            "entities": [
              {
                "name": "Product",
                "type": "ENTITY",
                "description": "Prodotto nel catalogo",
                "attributes": ["productId", "name", "description", "price", "category", "stock"],
                "invariants": ["Price must be positive", "Stock cannot be negative"]
              },
              {
                "name": "Category",
                "type": "ENTITY",
                "description": "Categoria prodotto",
                "attributes": ["categoryId", "name", "parentCategory"]
              }
            ],
            "valueObjects": [
              {
                "name": "Price",
                "type": "VALUE_OBJECT",
                "description": "Prezzo con valuta",
                "attributes": ["amount", "currency"]
              }
            ],
            "aggregates": [
              {
                "name": "ProductAggregate",
                "root": "Product",
                "entities": ["Product", "Category"],
                "valueObjects": ["Price"]
              }
            ]
          }
        ],
        "functionalRequirements": [
          {
            "id": "FR-CAT-001",
            "description": "Ogni prodotto deve appartenere a una categoria",
            "priority": "MEDIUM"
          },
          {
            "id": "FR-CAT-002",
            "description": "I prezzi devono essere aggiornabili in tempo reale",
            "priority": "HIGH"
          }
        ]
      }
    ],
    "supportingDomains": [
      {
        "name": "Inventory Management",
        "classification": "SUPPORTING",
        "valueProposition": "Gestione stock e disponibilità prodotti"
      }
    ]
  },
  "eventDrivenModel": {
    "events": [
      {
        "name": "OrderCreated",
        "description": "Ordine creato da cliente",
        "emitters": ["OrderService", "PaymentService"],
        "subscribers": ["InventoryService", "ShippingService", "NotificationService"],
        "payload": {
          "orderId": "string (UUID)",
          "customerId": "string (UUID)",
          "items": "array of OrderItem",
          "totalAmount": "number",
          "createdAt": "timestamp"
        },
        "trigger": "Customer completes checkout"
      },
      {
        "name": "OrderConfirmed",
        "description": "Ordine confermato dopo pagamento",
        "emitters": ["PaymentService"],
        "subscribers": ["OrderService", "ShippingService"],
        "payload": {
          "orderId": "string (UUID)",
          "paymentId": "string (UUID)",
          "confirmedAt": "timestamp"
        },
        "trigger": "Payment successful"
      },
      {
        "name": "ProductAdded",
        "description": "Nuovo prodotto aggiunto al catalogo",
        "emitters": ["CatalogService"],
        "subscribers": ["SearchService", "RecommendationService"],
        "payload": {
          "productId": "string (UUID)",
          "name": "string",
          "category": "string",
          "price": "number",
          "addedAt": "timestamp"
        },
        "trigger": "Admin adds new product"
      }
    ],
    "communicationPatterns": [
      {
        "sourceContext": "OrderContext",
        "targetContext": "InventoryContext",
        "pattern": "EVENT_DRIVEN",
        "description": "Ordini notificano inventory per aggiornamento stock",
        "events": ["OrderCreated", "OrderCancelled"]
      },
      {
        "sourceContext": "OrderContext",
        "targetContext": "PaymentContext",
        "pattern": "SYNCHRONOUS_API",
        "description": "Verifica disponibilità fondi in modo sincrono prima di confermare ordine",
        "timeout": "5s"
      },
      {
        "sourceContext": "CatalogContext",
        "targetContext": "OrderContext",
        "pattern": "SHARED_DATABASE",
        "description": "Condivisione dati prodotto tra catalogo e ordini",
        "concerns": "Possibile accoppiamento forte"
      }
    ]
  },
  "additionalContext": {
    "businessGoals": [
      "Aumentare tasso conversione checkout",
      "Ridurre errori negli ordini",
      "Migliorare esperienza utente"
    ],
    "constraints": [
      "Sistema legacy esistente per inventory",
      "Budget limitato per infrastruttura cloud",
      "Team piccolo (3 sviluppatori)"
    ],
    "assumptions": [
      "Volume ordini: ~1000/giorno",
      "Catalogo: ~10000 prodotti",
      "Picchi stagionali (Black Friday)"
    ]
  }
}
