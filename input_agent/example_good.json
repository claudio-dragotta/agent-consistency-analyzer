{
  "$schema": "https://intelligent-domain-architect.io/schemas/domain-model/v1.json",
  "metadata": {
    "modelId": "dm-ecommerce-good-001",
    "version": "1.0.1",
    "createdAt": "2025-01-15T10:00:00Z",
    "createdBy": "agent-1-domain-interviewer",
    "projectName": "E-Commerce Platform",
    "description": "Domain model for a complete B2C e-commerce platform supporting order management, payments, shipping, inventory, and customer management."
  },

  "businessContext": {
    "objectives": [
      "Enable customers to browse products and place orders online",
      "Process payments securely and efficiently",
      "Manage inventory and product catalog",
      "Handle shipping and delivery logistics",
      "Provide customer support and account management"
    ],
    "boundaries": [
      "B2C e-commerce only (no B2B features)",
      "Single currency (EUR) for MVP",
      "Domestic shipping only initially",
      "No marketplace functionality (single seller)"
    ],
    "stakeholders": [
      {
        "role": "Product Owner",
        "concerns": ["Customer experience", "Conversion rates", "Feature roadmap"]
      },
      {
        "role": "Operations Manager",
        "concerns": ["Order fulfillment", "Inventory management", "Shipping efficiency"]
      },
      {
        "role": "Finance Team",
        "concerns": ["Payment processing", "Revenue tracking", "Refund management"]
      }
    ]
  },

  "domainMap": {
    "coreDomains": [
      {
        "id": "order-management",
        "name": "Order Management",
        "type": "core",
        "description": "Handles the complete lifecycle of customer orders from creation to completion.",
        "justification": {
          "differentiating": true,
          "economicImpact": "high",
          "complexity": "high",
          "changeFrequency": "high",
          "errorSensitivity": "high"
        },
        "boundedContext": {
          "name": "OrderContext",
          "ubiquitousLanguage": {
            "Order": "A customer's request to purchase one or more products, with associated delivery and payment information",
            "OrderLine": "A single product entry within an order, including quantity and price snapshot at time of order",
            "OrderStatus": "The current state of an order in its lifecycle (Draft, Confirmed, Paid, FulfillmentInProgress, Shipped, Delivered, Cancelled, Refunded)",
            "Cart": "A temporary collection of products a customer intends to purchase",
            "Checkout": "The process of converting a cart into a confirmed order"
          }
        },
        "entities": [
          {
            "name": "Order",
            "type": "aggregate-root",
            "identity": "orderId (UUID)",
            "lifecycle": ["Draft", "Confirmed", "Paid", "FulfillmentInProgress", "Shipped", "Delivered", "Cancelled", "Refunded"],
            "attributes": [
              { "name": "orderId", "type": "UUID", "required": true },
              { "name": "customerId", "type": "UUID", "required": true },
              { "name": "orderLines", "type": "List<OrderLine>", "required": true },
              { "name": "status", "type": "OrderStatus", "required": true },

              { "name": "subTotal", "type": "Money", "required": true },
              { "name": "shippingFee", "type": "Money", "required": true },
              { "name": "taxAmount", "type": "Money", "required": true },
              { "name": "discountAmount", "type": "Money", "required": false },
              { "name": "totalAmount", "type": "Money", "required": true },

              { "name": "shippingAddress", "type": "Address", "required": true },
              { "name": "billingAddress", "type": "Address", "required": false },

              { "name": "createdAt", "type": "DateTime", "required": true },
              { "name": "confirmedAt", "type": "DateTime", "required": false }
            ],
            "invariants": [
              "order must have at least one orderLine",
              "all money values must have currency = EUR for MVP",
              "subTotal must equal sum(orderLines.lineTotal)",
              "totalAmount must equal subTotal + shippingFee + taxAmount - discountAmount (if present)",
              "order cannot be modified after status is Shipped"
            ]
          },
          {
            "name": "OrderLine",
            "type": "entity",
            "identity": "orderLineId (UUID)",
            "attributes": [
              { "name": "orderLineId", "type": "UUID", "required": true },
              { "name": "productId", "type": "UUID", "required": true },
              { "name": "sku", "type": "String", "required": true },
              { "name": "productName", "type": "String", "required": true },
              { "name": "quantity", "type": "Integer", "required": true },
              { "name": "unitPrice", "type": "Money", "required": true },
              { "name": "vatRate", "type": "Decimal", "required": false },
              { "name": "lineTotal", "type": "Money", "required": true }
            ],
            "invariants": [
              "quantity must be >= 1",
              "unitPrice.amount must be >= 0",
              "lineTotal must equal unitPrice * quantity (same currency)"
            ]
          }
        ],
        "valueObjects": [
          {
            "name": "Money",
            "attributes": [
              { "name": "amount", "type": "Decimal" },
              { "name": "currency", "type": "String" }
            ],
            "invariants": [
              "amount must be non-negative",
              "currency must be a valid ISO 4217 code",
              "for MVP, currency must be EUR"
            ]
          },
          {
            "name": "Address",
            "attributes": [
              { "name": "street", "type": "String" },
              { "name": "city", "type": "String" },
              { "name": "postalCode", "type": "String" },
              { "name": "country", "type": "String" }
            ],
            "invariants": [
              "for MVP domestic shipping only: country must be the domestic country code (e.g., IT) or follow a configured allowed list"
            ]
          }
        ],
        "functionalRequirements": [
          { "id": "FR-ORD-001", "description": "Customer can create an order from their cart", "priority": "must-have" },
          { "id": "FR-ORD-002", "description": "Customer can view their order history", "priority": "must-have" },
          { "id": "FR-ORD-003", "description": "Customer can cancel an order before shipping", "priority": "must-have" },
          { "id": "FR-ORD-004", "description": "System calculates order total including taxes and shipping", "priority": "must-have" }
        ]
      },

      {
        "id": "product-catalog",
        "name": "Product Catalog",
        "type": "core",
        "description": "Manages product information, categories, pricing, and availability.",
        "justification": {
          "differentiating": true,
          "economicImpact": "high",
          "complexity": "medium",
          "changeFrequency": "high",
          "errorSensitivity": "medium"
        },
        "boundedContext": {
          "name": "CatalogContext",
          "ubiquitousLanguage": {
            "Product": "An item available for sale with associated description, images, and pricing",
            "Category": "A grouping of related products for navigation and organization",
            "SKU": "Stock Keeping Unit - unique identifier for a specific product variant",
            "Price": "The current selling price of a product",
            "Availability": "Whether a product is currently purchasable"
          }
        },
        "entities": [
          {
            "name": "Product",
            "type": "aggregate-root",
            "identity": "productId (UUID)",
            "lifecycle": ["Draft", "Active", "Discontinued"],
            "attributes": [
              { "name": "productId", "type": "UUID", "required": true },
              { "name": "sku", "type": "String", "required": true },
              { "name": "name", "type": "String", "required": true },
              { "name": "description", "type": "String", "required": true },
              { "name": "price", "type": "Money", "required": true },
              { "name": "categoryId", "type": "UUID", "required": true },
              { "name": "isAvailable", "type": "Boolean", "required": true }
            ],
            "invariants": [
              "sku must be unique across all products",
              "price.amount must be > 0",
              "for MVP, price.currency must be EUR"
            ]
          },
          {
            "name": "Category",
            "type": "aggregate-root",
            "identity": "categoryId (UUID)",
            "attributes": [
              { "name": "categoryId", "type": "UUID", "required": true },
              { "name": "name", "type": "String", "required": true },
              { "name": "parentCategoryId", "type": "UUID", "required": false }
            ]
          }
        ],
        "functionalRequirements": [
          { "id": "FR-CAT-001", "description": "Customer can browse products by category", "priority": "must-have" },
          { "id": "FR-CAT-002", "description": "Customer can search products by name or description", "priority": "must-have" },
          { "id": "FR-CAT-003", "description": "Admin can add, update, and remove products", "priority": "must-have" }
        ]
      }
    ],

    "supportingDomains": [
      {
        "id": "payment-processing",
        "name": "Payment Processing",
        "type": "supporting",
        "description": "Handles payment transactions and refunds. Supports Order Management.",
        "supportsCoreDomains": ["order-management"],
        "boundedContext": {
          "name": "PaymentContext",
          "ubiquitousLanguage": {
            "Payment": "A financial transaction associated with an order",
            "PaymentMethod": "The means by which a customer pays (card, bank transfer, etc.)",
            "PaymentStatus": "The current state of a payment (Pending, Authorized, Captured, Failed, Refunded)",
            "Refund": "A reversal of a previous payment, returning funds to the customer"
          }
        },
        "entities": [
          {
            "name": "Payment",
            "type": "aggregate-root",
            "identity": "paymentId (UUID)",
            "lifecycle": ["Pending", "Authorized", "Captured", "Failed", "Refunded"],
            "attributes": [
              { "name": "paymentId", "type": "UUID", "required": true },
              { "name": "orderId", "type": "UUID", "required": true },
              { "name": "amount", "type": "Money", "required": true },
              { "name": "status", "type": "PaymentStatus", "required": true },
              { "name": "paymentMethodId", "type": "UUID", "required": true }
            ],
            "invariants": [
              "for MVP, amount.currency must be EUR"
            ]
          }
        ],
        "functionalRequirements": [
          { "id": "FR-PAY-001", "description": "System processes payment when order is confirmed", "priority": "must-have" },
          { "id": "FR-PAY-002", "description": "System supports refunds for cancelled orders", "priority": "must-have" }
        ]
      },

      {
        "id": "shipping",
        "name": "Shipping & Delivery",
        "type": "supporting",
        "description": "Manages shipment creation, carrier integration, and delivery tracking. Supports Order Management.",
        "supportsCoreDomains": ["order-management"],
        "boundedContext": {
          "name": "ShippingContext",
          "ubiquitousLanguage": {
            "Shipment": "A physical package containing ordered items sent to a customer",
            "Carrier": "A logistics provider used to deliver shipments",
            "TrackingNumber": "A unique identifier for tracking a shipment's progress",
            "DeliveryStatus": "The current state of a shipment (Preparing, Dispatched, InTransit, Delivered, Returned)"
          }
        },
        "entities": [
          {
            "name": "Shipment",
            "type": "aggregate-root",
            "identity": "shipmentId (UUID)",
            "lifecycle": ["Preparing", "Dispatched", "InTransit", "Delivered", "Returned"],
            "attributes": [
              { "name": "shipmentId", "type": "UUID", "required": true },
              { "name": "orderId", "type": "UUID", "required": true },
              { "name": "trackingNumber", "type": "String", "required": false },
              { "name": "carrierCode", "type": "String", "required": true },
              { "name": "status", "type": "DeliveryStatus", "required": true },
              { "name": "shippingAddress", "type": "Address", "required": true }
            ]
          }
        ],
        "functionalRequirements": [
          { "id": "FR-SHP-001", "description": "System creates shipment when order is paid", "priority": "must-have" },
          { "id": "FR-SHP-002", "description": "Customer can track their shipment status", "priority": "must-have" }
        ]
      },

      {
        "id": "customer-management",
        "name": "Customer Management",
        "type": "supporting",
        "description": "Manages customer profiles, addresses, and preferences. Supports Order Management.",
        "supportsCoreDomains": ["order-management"],
        "boundedContext": {
          "name": "CustomerContext",
          "ubiquitousLanguage": {
            "Customer": "A registered user who can place orders",
            "CustomerProfile": "Personal information and preferences of a customer",
            "SavedAddress": "A delivery address stored by a customer for reuse"
          }
        },
        "entities": [
          {
            "name": "Customer",
            "type": "aggregate-root",
            "identity": "customerId (UUID)",
            "lifecycle": ["Active", "Suspended", "Deleted"],
            "attributes": [
              { "name": "customerId", "type": "UUID", "required": true },
              { "name": "email", "type": "Email", "required": true },
              { "name": "name", "type": "String", "required": true },
              { "name": "savedAddresses", "type": "List<Address>", "required": false }
            ],
            "invariants": [
              "email must be unique across all customers"
            ]
          }
        ],
        "valueObjects": [
          {
            "name": "Email",
            "attributes": [
              { "name": "value", "type": "String" }
            ],
            "invariants": [
              "value must be a valid email format"
            ]
          }
        ],
        "functionalRequirements": [
          { "id": "FR-CUS-001", "description": "Customer can register and manage their profile", "priority": "must-have" },
          { "id": "FR-CUS-002", "description": "Customer can save multiple delivery addresses", "priority": "should-have" }
        ]
      },

      {
        "id": "inventory",
        "name": "Inventory Management",
        "type": "supporting",
        "description": "Tracks stock levels and manages inventory operations. Supports Product Catalog and Order Management.",
        "supportsCoreDomains": ["product-catalog", "order-management"],
        "boundedContext": {
          "name": "InventoryContext",
          "ubiquitousLanguage": {
            "StockItem": "A record of on-hand quantity for a specific product",
            "OnHandQuantity": "The total physical quantity available in the warehouse",
            "Reservation": "A temporary hold on stock for a pending order",
            "Restock": "Addition of new inventory for a product"
          }
        },
        "entities": [
          {
            "name": "StockItem",
            "type": "aggregate-root",
            "identity": "stockItemId (UUID)",
            "attributes": [
              { "name": "stockItemId", "type": "UUID", "required": true },
              { "name": "productId", "type": "UUID", "required": true },
              { "name": "onHandQuantity", "type": "Integer", "required": true },
              { "name": "reservedQuantity", "type": "Integer", "required": true }
            ],
            "invariants": [
              "onHandQuantity must be >= 0",
              "reservedQuantity must be >= 0",
              "reservedQuantity must be <= onHandQuantity"
            ]
          }
        ],
        "functionalRequirements": [
          { "id": "FR-INV-001", "description": "System reserves stock when order is created", "priority": "must-have" },
          { "id": "FR-INV-002", "description": "System releases reserved stock when order is cancelled", "priority": "must-have" }
        ]
      }
    ],

    "genericDomains": [
      {
        "id": "notification",
        "name": "Notification Service",
        "type": "generic",
        "description": "Handles sending emails, SMS, and push notifications.",
        "implementationStrategy": "Use third-party service (SendGrid, Twilio)",
        "functionalRequirements": [
          { "id": "FR-NOT-001", "description": "System sends order confirmation email", "priority": "must-have" },
          { "id": "FR-NOT-002", "description": "System sends shipping notification with tracking", "priority": "must-have" }
        ]
      },
      {
        "id": "authentication",
        "name": "Authentication & Authorization",
        "type": "generic",
        "description": "Handles user authentication, session management, and access control.",
        "implementationStrategy": "Use identity provider (Auth0, Keycloak)",
        "functionalRequirements": [
          { "id": "FR-AUTH-001", "description": "User can login with email and password", "priority": "must-have" },
          { "id": "FR-AUTH-002", "description": "System supports password reset flow", "priority": "must-have" }
        ]
      }
    ]
  },

  "eventDrivenModel": {
    "events": [
      {
        "name": "OrderCreated",
        "emitter": "order-management",
        "description": "Emitted when a new order is successfully created",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "orderId": "UUID",
          "customerId": "UUID",
          "totalAmount": "Money",
          "orderLines": "List<OrderLineDTO>"
        },
        "consumers": ["inventory", "notification"]
      },

      {
        "name": "OrderConfirmed",
        "emitter": "order-management",
        "description": "Emitted when customer confirms their order",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "orderId": "UUID",
          "confirmedAt": "DateTime"
        },
        "consumers": ["payment-processing"]
      },

      {
        "name": "OrderCancelled",
        "emitter": "order-management",
        "description": "Emitted when an order is cancelled",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "orderId": "UUID",
          "reason": "String",
          "cancelledAt": "DateTime"
        },
        "consumers": ["payment-processing", "inventory", "shipping", "notification"]
      },

      {
        "name": "PaymentAuthorized",
        "emitter": "payment-processing",
        "description": "Emitted when payment is successfully authorized",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "paymentId": "UUID",
          "orderId": "UUID",
          "amount": "Money",
          "authorizedAt": "DateTime"
        },
        "consumers": ["order-management"]
      },

      {
        "name": "PaymentCaptured",
        "emitter": "payment-processing",
        "description": "Emitted when payment is captured",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "paymentId": "UUID",
          "orderId": "UUID",
          "capturedAt": "DateTime"
        },
        "consumers": ["order-management"]
      },

      {
        "name": "OrderPaid",
        "emitter": "order-management",
        "description": "Emitted after Order Management updates order status to Paid (after consuming PaymentCaptured)",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "orderId": "UUID",
          "paidAt": "DateTime",
          "totalAmount": "Money"
        },
        "consumers": ["shipping", "notification"]
      },

      {
        "name": "PaymentFailed",
        "emitter": "payment-processing",
        "description": "Emitted when payment processing fails",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "paymentId": "UUID",
          "orderId": "UUID",
          "failureReason": "String"
        },
        "consumers": ["order-management", "notification"]
      },

      {
        "name": "ShipmentCreated",
        "emitter": "shipping",
        "description": "Emitted when a shipment is created for an order",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "shipmentId": "UUID",
          "orderId": "UUID",
          "carrierCode": "String"
        },
        "consumers": ["order-management"]
      },

      {
        "name": "ShipmentDispatched",
        "emitter": "shipping",
        "description": "Emitted when shipment is handed to carrier",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "shipmentId": "UUID",
          "orderId": "UUID",
          "trackingNumber": "String",
          "dispatchedAt": "DateTime"
        },
        "consumers": ["order-management", "notification"]
      },

      {
        "name": "ShipmentDelivered",
        "emitter": "shipping",
        "description": "Emitted when shipment is delivered",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "shipmentId": "UUID",
          "orderId": "UUID",
          "deliveredAt": "DateTime"
        },
        "consumers": ["order-management", "notification"]
      },

      {
        "name": "StockReserved",
        "emitter": "inventory",
        "description": "Emitted when stock is reserved for an order",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "reservationId": "UUID",
          "orderId": "UUID",
          "items": "List<ReservedItemDTO>"
        },
        "consumers": ["order-management"]
      },

      {
        "name": "StockReservationFailed",
        "emitter": "inventory",
        "description": "Emitted when stock reservation fails due to insufficient inventory",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "orderId": "UUID",
          "failedItems": "List<FailedItemDTO>"
        },
        "consumers": ["order-management", "notification"]
      },

      {
        "name": "ProductAvailabilityChanged",
        "emitter": "product-catalog",
        "description": "Emitted when a product's availability status changes",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "productId": "UUID",
          "isAvailable": "Boolean",
          "changedAt": "DateTime"
        },
        "consumers": ["inventory"]
      },

      {
        "name": "CustomerRegistered",
        "emitter": "customer-management",
        "description": "Emitted when a new customer registers",
        "meta": {
          "eventId": "UUID",
          "occurredAt": "DateTime",
          "schemaVersion": "1",
          "correlationId": "String",
          "causationId": "String"
        },
        "payload": {
          "customerId": "UUID",
          "email": "String",
          "registeredAt": "DateTime"
        },
        "consumers": ["notification"]
      }
    ],
    "patterns": {
      "primary": "pub-sub",
      "messaging": {
        "broker": "Apache Kafka",
        "topicNamingConvention": "{domain}.{event-name}",
        "partitioning": "By aggregate ID"
      },
      "guarantees": {
        "delivery": "at-least-once",
        "ordering": "per-partition (by aggregate ID)"
      }
    }
  },

  "contextIntegrations": [
    {
      "upstream": "order-management",
      "downstream": "payment-processing",
      "relationship": "customer-supplier",
      "integrationPattern": "event-driven",
      "description": "Order Management publishes order events, Payment Processing reacts to process payments"
    },
    {
      "upstream": "order-management",
      "downstream": "shipping",
      "relationship": "customer-supplier",
      "integrationPattern": "event-driven",
      "description": "Order Management emits OrderPaid, Shipping creates shipments"
    },
    {
      "upstream": "order-management",
      "downstream": "inventory",
      "relationship": "customer-supplier",
      "integrationPattern": "event-driven",
      "description": "Order Management publishes OrderCreated/Cancelled, Inventory manages stock reservations"
    },
    {
      "upstream": "product-catalog",
      "downstream": "order-management",
      "relationship": "conformist",
      "integrationPattern": "sync-query",
      "description": "Order Management queries Product Catalog for product details during checkout (consider ACL if model stability is required)"
    },
    {
      "upstream": "customer-management",
      "downstream": "order-management",
      "relationship": "conformist",
      "integrationPattern": "sync-query",
      "description": "Order Management queries Customer Management for customer identity and addresses (consider ACL if model stability is required)"
    }
  ]
}
