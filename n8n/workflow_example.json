{
  "name": "Agent 2 - DDD Consistency Analyzer",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analyze-domain",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8002/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"domain_model\": $json.body.domain_model, \"use_llm\": $json.body.use_llm ?? true, \"apply_auto_fixes\": $json.body.apply_auto_fixes ?? true }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "agent2-analyze",
      "name": "Agent 2 - Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-issues",
              "leftValue": "={{ $json.summary.total_issues }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-issues",
      "name": "Has Issues?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "={{ $json.status }}"
            },
            {
              "name": "total_issues",
              "value": "={{ $json.summary.total_issues }}"
            },
            {
              "name": "entity_overlaps",
              "value": "={{ $json.summary.entity_overlaps }}"
            },
            {
              "name": "semantic_ambiguities",
              "value": "={{ $json.summary.semantic_ambiguities }}"
            },
            {
              "name": "requirement_conflicts",
              "value": "={{ $json.summary.requirement_conflicts }}"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-summary",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-issues",
      "name": "Respond with Issues",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"VALID\", \"message\": \"No issues found in domain model\" }",
        "options": {}
      },
      "id": "respond-valid",
      "name": "Respond Valid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Agent 2 - Analyze",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent 2 - Analyze": {
      "main": [
        [
          {
            "node": "Has Issues?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Issues?": {
      "main": [
        [
          {
            "node": "Extract Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Summary": {
      "main": [
        [
          {
            "node": "Respond with Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
